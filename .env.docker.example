# Copy to .env.runtime. Values must be Docker env-file format: KEY=value,
# no shell export, no outer quotes, and one line per value.
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
DATABASE_URL=
DATABASE_SSL=require
DB_POOL_MAX=5

# These four PUBLIC values are required at build time. Rebuild when they change.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only provider configuration. Use the same Firebase project as above.
FIREBASE_PROJECT_ID=
# Paste compact JSON on ONE line, preserving the private_key's escaped \n values.
# Alternatively mount a credential file and set GOOGLE_APPLICATION_CREDENTIALS
# to its path INSIDE the container, or use the host provider's ADC integration.
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_DAILY_CALL_LIMIT=500
# Optional authenticated indexing recovery endpoint; no scheduler is started.
INDEXING_JOB_SECRET=

# Enable after adding the Maps and Places configuration.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_DEMO_MODE=false
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
GOOGLE_PLACES_SERVER_KEY=
OFFICE_PAGE_TOKEN_SECRET=
OFFICE_DAILY_CALL_LIMIT=500
# For the same prototype configuration verified during the demo, explicitly set
# GOOGLE_MAPS_ENABLED=true, GOOGLE_MAPS_DEMO_MODE=true, and the supplied demo key.
REACT_APP_GOOGLE_MAPS_DEMO_KEY=

# Deployment never runs a seed automatically. Do not configure auth emulators.
ALLOW_FICTIONAL_SEED=false
