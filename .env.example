# No secrets are committed. Use .env.local for Next.js; CLI commands use --env-file=.env.local.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Require TLS in hosted environments; local isolated tests may set disable.
DATABASE_SSL=require
DB_POOL_MAX=5
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively use application default credentials / GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
GEMINI_API_KEY=
# Existing GOOGLE_API_KEY is also accepted for Gemini only.
GOOGLE_API_KEY=
GEMINI_DAILY_CALL_LIMIT=500
INDEXING_JOB_SECRET=
# Vercel native Cron GET adapter; separate from external POST scheduler secret.
CRON_SECRET=
GOOGLE_MAPS_ENABLED=false
# Explicit prototype opt-in; Google Maps Demo Key supports Maps JS and Places New.
# This opt-in is independent of NODE_ENV; keep false for real-member production.
GOOGLE_MAPS_DEMO_MODE=false
REACT_APP_GOOGLE_MAPS_DEMO_KEY=
# Canonical separate credentials take precedence; use these for production launch.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
GOOGLE_PLACES_SERVER_KEY=
OFFICE_PAGE_TOKEN_SECRET=
OFFICE_DAILY_CALL_LIMIT=500
# Optional legacy Cloud Run identifiers; Vercel is the owner's preferred target.
GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_REGION=us-east4
CLOUD_RUN_SERVICE=diverse-dmv
APP_DOMAIN=
# Local tests only. Never set emulator configuration on a hosted deployment.
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
# Fictional demo seeding only; opt in against a separate demo database.
ALLOW_FICTIONAL_SEED=false
DEMO_ACCOUNT_PASSWORD=
